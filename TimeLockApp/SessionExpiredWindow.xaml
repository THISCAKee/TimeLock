<Window x:Class="TimeLockApp.SessionExpiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TimeExpiredTitle}"
        Width="460"
        Height="310"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Margin="18"
            Padding="30"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="0"
                              Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource SessionExpiredHeading}"
                       HorizontalAlignment="Center"
                       Foreground="#111827"
                       FontSize="24"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="CountdownTextBlock"
                       Grid.Row="1"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Foreground="#DC2626"
                       FontSize="18"
                       FontWeight="Medium"/>

            <TextBlock x:Name="ReasonTextBlock"
                       Grid.Row="2"
                       Margin="10,16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#4B5563"
                       FontSize="14"/>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ExtendButton"
                        Grid.Column="0"
                        Height="44"
                        Content="{DynamicResource ExtendThreeHours}"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="ExtendButton_Click"/>

                <Button Grid.Column="2"
                        Height="44"
                        Content="{DynamicResource Logout}"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="LogoutButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
