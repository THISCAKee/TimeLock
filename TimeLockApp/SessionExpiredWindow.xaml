<Window x:Class="TimeLockApp.SessionExpiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TimeExpiredTitle}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        Background="#B8000000"
        Focusable="True">
    <Grid Background="#B8000000">
        <Border Width="520"
                MinHeight="330"
                Margin="24"
                Padding="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.28"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource SessionExpiredHeading}"
                           HorizontalAlignment="Center"
                           Foreground="#111827"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="CountdownTextBlock"
                           Grid.Row="1"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#DC2626"
                           FontSize="20"
                           FontWeight="Medium"/>

                <TextBlock x:Name="ReasonTextBlock"
                           Grid.Row="2"
                           Margin="10,20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#4B5563"
                           FontSize="16"/>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ExtendButton"
                            Grid.Column="0"
                            Height="48"
                            Content="{DynamicResource ExtendThreeHours}"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="ExtendButton_Click"/>

                    <Button Grid.Column="2"
                            Height="48"
                            Content="{DynamicResource Logout}"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="LogoutButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
