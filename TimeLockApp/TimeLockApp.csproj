<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

   <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Fonts\Anuphan-Regular.ttf" />
    <Resource Include="Assets\Fonts\Anuphan-Medium.ttf" />
    <Resource Include="Assets\Fonts\Anuphan-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Anuphan-Bold.ttf" />
    <Resource Include="Assets\Fonts\Anuphan-Light.ttf" />
  </ItemGroup>
  
  <ItemGroup>
  <Compile Remove="Services\GoogleSheetsUserService.cs" />
  <Compile Remove="Configuration\GoogleSheetsConfig.cs" />
  <Compile Remove="TimeLockApp.Tests\**\*.cs" />
  <Compile Remove="TimeLockApp.AdminWeb\**\*.cs" />
  <None Remove="TimeLockApp.AdminWeb\**\*" />
</ItemGroup>

</Project>
