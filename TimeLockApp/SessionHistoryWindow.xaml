<Window x:Class="TimeLockApp.SessionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session History"
        Width="980"
        Height="620"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F9FAFB">

    <Grid Background="#F9FAFB"
          Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0 0 0 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="56"
                    Height="56"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="16"
                    Margin="0 0 14 0">
                <Image Source="/Assets/logo.png"
                       Width="42"
                       Height="42"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="Session History"
                           Foreground="#111827"
                           FontSize="26"
                           FontWeight="SemiBold"/>

                <TextBlock Text="ประวัติการใช้งานของผู้ใช้ทั้งหมด"
                           Foreground="#6B7280"
                           FontSize="14"
                           Margin="0 3 0 0"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="110"
                        Height="40"
                        Margin="0 0 10 0"
                        Click="RefreshButton_Click"/>

                <Button Content="ล้างประวัติ"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="130"
                        Height="40"
                        Click="ClearHistoryButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="0.07"/>
            </Border.Effect>

            <DataGrid x:Name="SessionsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="40"
                      Background="White"
                      BorderThickness="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Username"
                                        Binding="{Binding Username}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Start Time"
                                        Binding="{Binding StartTime}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="End Time"
                                        Binding="{Binding EndTime}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Allowed"
                                        Binding="{Binding AllowedMinutes}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Used"
                                        Binding="{Binding UsedTimeDisplay}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 20 0 0">

            <Button Content="ปิด"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="120"
                    Height="40"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>