<Window x:Class="TimeLockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Lock App"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="White"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Grid Background="White">
        <Border Width="430"
                Padding="36"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.13"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo จริง -->
                <Image Source="/Assets/logo.png"
                       Width="112"
                       Height="112"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 18"/>

                <TextBlock Text="Time Lock"
                           FontSize="31"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="กรุณาเข้าสู่ระบบเพื่อเริ่มใช้งาน"
                           FontSize="14"
                           Foreground="#6B7280"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0 8 0 30"/>

                <!-- Username -->
                <TextBlock Text="Username"
                           Foreground="#374151"
                           FontSize="14"
                           FontWeight="Medium"
                           Margin="0 0 0 7"/>

                <Border Height="46"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="13"
                        Margin="0 0 0 16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="👤"
                                   Grid.Column="0"
                                   FontSize="17"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBox x:Name="UsernameTextBox"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="15"
                                 TextChanged="UsernameTextBox_TextChanged"/>

                        <TextBlock x:Name="UsernamePlaceholderTextBlock"
                                   Grid.Column="1"
                                   Text="กรอกชื่อผู้ใช้งาน"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Password -->
                <TextBlock Text="Password"
                           Foreground="#374151"
                           FontSize="14"
                           FontWeight="Medium"
                           Margin="0 0 0 7"/>

                <Border Height="46"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="13"
                        Margin="0 0 0 22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🔒"
                                   Grid.Column="0"
                                   FontSize="17"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     FontSize="15"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                        <TextBlock x:Name="PasswordPlaceholderTextBlock"
                                   Grid.Column="1"
                                   Text="กรอกรหัสผ่าน"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Button Content="เข้าสู่ระบบ"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        FontSize="16"
                        Click="LoginButton_Click"/>

                <TextBlock x:Name="MessageTextBlock"
                           Foreground="#DC2626"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0 18 0 0"/>

                <TextBlock x:Name="NetworkStatusTextBlock"
                           Text="หากยังไม่ได้ Authen Internet กรุณากดเชื่อมต่ออินเทอร์เน็ต"
                           Foreground="#6B7280"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
                <Button x:Name="NetworkAuthButton"
                        Content="เชื่อมต่ออินเทอร์เน็ต"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="44"
                        FontSize="15"
                        Margin="0,10,0,0"
                        Click="NetworkAuthButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>