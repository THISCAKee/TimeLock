<Window x:Class="TimeLockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="#EAF2F9"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style x:Key="UsageGuideSectionStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Background"
                    Value="#F3F7FA"/>
            <Setter Property="BorderBrush"
                    Value="#E1EAF0"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="16"/>
            <Setter Property="Padding"
                    Value="18"/>
            <Setter Property="Margin"
                    Value="6"/>
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UsageGuideSectionTitleStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#1F3B4D"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <Style x:Key="UsageGuideSectionBodyStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="Normal"/>
            <Setter Property="Foreground"
                    Value="#3F5565"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="LineHeight"
                    Value="22"/>
            <Setter Property="Margin"
                    Value="0,8,0,0"/>
        </Style>
        <Style x:Key="LoginMotionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoginSecondaryMotionButtonStyle" TargetType="Button" BasedOn="{StaticResource LoginMotionButtonStyle}">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="#F3F4F6"/>
        </Style>
        <Style x:Key="LoginDangerMotionButtonStyle" TargetType="Button" BasedOn="{StaticResource LoginMotionButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#F3F8FC"
                              Offset="0"/>
                <GradientStop Color="#E7F1F7"
                              Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="560"
                 Height="560"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="90,-270,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4E8EB6D0"
                                  Offset="0"/>
                    <GradientStop Color="#1F8EB6D0"
                                  Offset="0.58"/>
                    <GradientStop Color="#008EB6D0"
                                  Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="640"
                 Height="640"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,70,-350"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#397FB7C7"
                                  Offset="0"/>
                    <GradientStop Color="#197FB7C7"
                                  Offset="0.56"/>
                    <GradientStop Color="#007FB7C7"
                                  Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="LoginAndGuideLayout"
              MaxWidth="1380"
              Margin="32"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

        <Border x:Name="LoginPanel"
                Grid.Column="1"
                Width="430"
                Margin="20,0,0,0"
                Padding="36,28"
                BorderBrush="#DCE6EE"
                BorderThickness="1"
                CornerRadius="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF"
                                  Offset="0"/>
                    <GradientStop Color="#FFFFFFFF"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>


            <StackPanel>
                <Border Width="146"
                        Height="40"
                        HorizontalAlignment="Right"
                        Margin="0 0 0 12"
                        Background="#F3F6F9"
                        BorderBrush="#DFE7ED"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🌐"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <ToggleButton x:Name="ThaiLanguageButton"
                                      Grid.Column="1"
                                      Content="TH"
                                      IsChecked="True"
                                      Style="{StaticResource LanguageSegmentButtonStyle}"
                                      Click="ThaiLanguageButton_Click"/>

                        <Border Grid.Column="2"
                                Width="1"
                                Height="18"
                                Background="#D1D5DB"
                                VerticalAlignment="Center"/>

                        <ToggleButton x:Name="EnglishLanguageButton"
                                      Grid.Column="3"
                                      Content="EN"
                                      Style="{StaticResource LanguageSegmentButtonStyle}"
                                      Click="EnglishLanguageButton_Click"/>
                    </Grid>
                </Border>

                <!-- Logo จริง -->
                <Image Source="/Assets/logo.png"
                       Width="88"
                       Height="88"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 16"/>

                <TextBlock Text="{DynamicResource LoginHeading}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{DynamicResource LoginHelp}"
                           FontSize="15"
                           Foreground="#6B7280"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0 8 0 26"/>

                <!-- Username -->
                <TextBlock Text="{DynamicResource Username}"
                           Foreground="#374151"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0 0 0 7"/>

                <Border Height="50"
                        BorderThickness="1"
                        CornerRadius="14"
                        Margin="0 0 0 16">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background"
                                    Value="#F7FAFC"/>
                            <Setter Property="BorderBrush"
                                    Value="#B8CAD6"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#F4FFFFFF"/>
                                    <Setter Property="BorderBrush"
                                            Value="#4C7F9E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="👤"
                                   Grid.Column="0"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBox x:Name="UsernameTextBox"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="16"
                                 TextChanged="UsernameTextBox_TextChanged"/>

                        <TextBlock x:Name="UsernamePlaceholderTextBlock"
                                   Grid.Column="1"
                                   Text="{DynamicResource UsernamePlaceholder}"
                                   Foreground="#536B7C"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Password -->
                <TextBlock Text="{DynamicResource Password}"
                           Foreground="#374151"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0 0 0 7"/>

                <Border Height="50"
                        BorderThickness="1"
                        CornerRadius="14"
                        Margin="0 0 0 22">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background"
                                    Value="#F7FAFC"/>
                            <Setter Property="BorderBrush"
                                    Value="#B8CAD6"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#F4FFFFFF"/>
                                    <Setter Property="BorderBrush"
                                            Value="#4C7F9E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🔒"
                                   Grid.Column="0"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     FontSize="16"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                        <TextBlock x:Name="PasswordPlaceholderTextBlock"
                                   Grid.Column="1"
                                   Text="{DynamicResource PasswordPlaceholder}"
                                   Foreground="#536B7C"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Button x:Name="LoginButton"
                        Content="{DynamicResource LoginButton}"
                        Height="52"
                        FontSize="17"
                        Click="LoginButton_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}"
                               BasedOn="{StaticResource LoginMotionButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Opacity"
                                            Value="0.55"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">
                            <GradientStop Color="#176B87"
                                          Offset="0"/>
                            <GradientStop Color="#114B68"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <TextBlock x:Name="MessageTextBlock"
                           Foreground="#DC2626"
                           FontSize="15"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0 18 0 0"/>

                <TextBlock x:Name="NetworkStatusTextBlock"
                           Text="{DynamicResource NetworkHint}"
                           Foreground="#485E6D"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
                <Button x:Name="NetworkAuthButton"
                        Content="{DynamicResource ConnectInternet}"
                        Height="44"
                        FontSize="16"
                        Margin="0,10,0,0"
                        Click="NetworkAuthButton_Click"
                        Background="#EAF2F6">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}"
                               BasedOn="{StaticResource LoginSecondaryMotionButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Opacity"
                                            Value="0.55"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="{DynamicResource ShutdownComputer}"
                        Style="{StaticResource LoginDangerMotionButtonStyle}"
                        Height="44"
                        FontSize="16"
                        Margin="0,10,0,0"
                        Click="ShutdownButton_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="UsageGuidePanel"
                Grid.Column="0"
                Height="700"
                MaxHeight="700"
                Margin="0,0,16,0"
                Padding="28"
                BorderBrush="#DCE6EE"
                BorderThickness="1"
                CornerRadius="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF"
                                  Offset="0"/>
                    <GradientStop Color="#FFFFFFFF"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource UsageGuideTitle}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#183447"/>
                        <TextBlock Text="{DynamicResource UsageGuideIntro}"
                                   FontSize="16"
                                   Foreground="#455B6A"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <UniformGrid Columns="2"
                                 Rows="3">
                        <Border Style="{StaticResource UsageGuideSectionStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="#DFEDF5"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="01"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#356782"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{DynamicResource UsageGuideBeforeTitle}"
                                               Style="{StaticResource UsageGuideSectionTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource UsageGuideBeforeBody}"
                                               Style="{StaticResource UsageGuideSectionBodyStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource UsageGuideSectionStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="#DFEDF5"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="02"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#356782"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{DynamicResource UsageGuideLoginTitle}"
                                               Style="{StaticResource UsageGuideSectionTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource UsageGuideLoginBody}"
                                               Style="{StaticResource UsageGuideSectionBodyStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource UsageGuideSectionStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="#DFEDF5"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="03"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#356782"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{DynamicResource UsageGuideInternetTitle}"
                                               Style="{StaticResource UsageGuideSectionTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource UsageGuideInternetBody}"
                                               Style="{StaticResource UsageGuideSectionBodyStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource UsageGuideSectionStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="#DFEDF5"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="04"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#356782"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{DynamicResource UsageGuideDuringTitle}"
                                               Style="{StaticResource UsageGuideSectionTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource UsageGuideDuringBody}"
                                               Style="{StaticResource UsageGuideSectionBodyStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource UsageGuideSectionStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="#DFEDF5"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="05"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#356782"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{DynamicResource UsageGuideFinishTitle}"
                                               Style="{StaticResource UsageGuideSectionTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource UsageGuideFinishBody}"
                                               Style="{StaticResource UsageGuideSectionBodyStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource UsageGuideSectionStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="#DFEDF5"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="06"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#356782"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{DynamicResource UsageGuideHelpTitle}"
                                               Style="{StaticResource UsageGuideSectionTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource UsageGuideHelpBody}"
                                               Style="{StaticResource UsageGuideSectionBodyStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Text="{DynamicResource UsageGuideFooter}"
                           FontSize="14"
                           Foreground="#4F6473"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"/>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
