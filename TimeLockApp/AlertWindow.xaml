<Window x:Class="TimeLockApp.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#CC000000">

    <Grid>
        <Border Width="460"
                Padding="30"
                Background="#2D2D30"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock x:Name="TitleTextBlock"
                           Text="แจ้งเตือน"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0 0 0 20"/>

                <TextBlock x:Name="MessageTextBlock"
                           Text="ข้อความแจ้งเตือน"
                           Foreground="White"
                           FontSize="20"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0 0 0 28"/>

                <Button Content="OK"
                        Width="140"
                        Height="42"
                        FontSize="18"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Click="OkButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>