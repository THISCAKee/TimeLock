<Window x:Class="TimeLockApp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AdminPanel}"
        Width="1080"
        Height="680"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F9FAFB">

    <Grid Background="#F9FAFB"
          Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0 0 0 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="56"
                    Height="56"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="16"
                    Margin="0 0 14 0">
                <Image Source="/Assets/logo.png"
                       Width="42"
                       Height="42"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AdminPanel}"
                           Foreground="#111827"
                           FontSize="26"
                           FontWeight="SemiBold"/>

                <TextBlock Text="{DynamicResource AdminSubtitle}"
                           Foreground="#6B7280"
                           FontSize="14"
                           Margin="0 3 0 0"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- User Table Card -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="16">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.07"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Users}"
                                       Foreground="#111827"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{DynamicResource SelectUserHint}"
                                       Foreground="#6B7280"
                                       FontSize="12"
                                       Margin="0 2 0 0"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="UsersDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="40"
                              Background="White"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionChanged="UsersDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Username}"
                                                Binding="{Binding Username}"
                                                Width="1.4*"/>
                            <DataGridTemplateColumn Width="1.2*">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Password}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="PasswordVisibilityButton"
                                                Content="{DynamicResource Show}"
                                                Margin="8 0 0 0"
                                                Padding="7 2"
                                                FontSize="11"
                                                Click="PasswordVisibilityButton_Click"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="••••••"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True"
                                                                         Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=IsPasswordVisible}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Password}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True"
                                                                         Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=IsPasswordVisible}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Minutes}"
                                                Binding="{Binding AllowedMinutes}"
                                                Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource Role}"
                                                Binding="{Binding Role}"
                                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Form Card -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.07"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0 0 0 14">
                        <TextBlock Text="{DynamicResource UserDetail}"
                                   Foreground="#111827"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{DynamicResource UserDetailSubtitle}"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0 2 0 0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <TextBlock Text="{DynamicResource Username}"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0 0 0 6"/>

                            <Border Height="42"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Margin="0 0 0 11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="👤"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBox x:Name="UsernameTextBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource Password}"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0 0 0 6"/>

                            <Border Height="42"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Margin="0 0 0 11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="🔒"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBox x:Name="PasswordTextBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource AllowedMinutes}"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0 0 0 6"/>

                            <Border Height="42"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Margin="0 0 0 11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="⏱"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBox x:Name="AllowedMinutesTextBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#111827"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             Padding="0"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource Role}"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0 0 0 6"/>

                            <ComboBox x:Name="RoleComboBox"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Margin="0 0 0 14">
                                <ComboBoxItem Content="{DynamicResource UserRole}"/>
                                <ComboBoxItem Content="{DynamicResource AdminRole}"/>
                            </ComboBox>

                            <TextBlock x:Name="MessageTextBlock"
                                       Foreground="#DC2626"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       MinHeight="34"
                                       Margin="0 2 0 8"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Buttons fixed bottom -->
                    <Grid Grid.Row="2"
                          Margin="0 14 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="{DynamicResource Add}"
                                    Grid.Column="0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="40"
                                    Click="AddButton_Click"/>

                            <Button Content="{DynamicResource Edit}"
                                    Grid.Column="2"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="40"
                                    Click="UpdateButton_Click"/>
                        </Grid>

                        <Button Content="{DynamicResource DeleteUser}"
                                Grid.Row="2"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="40"
                                Click="DeleteButton_Click"/>

                        <Button Content="{DynamicResource ClearForm}"
                                Grid.Row="4"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="40"
                                Click="ClearButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2"
              Margin="0 20 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{DynamicResource AdminTip}"
                       Foreground="#6B7280"
                       FontSize="13"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="{DynamicResource History}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="160"
                        Height="40"
                        Margin="0 0 10 0"
                        Click="SessionHistoryButton_Click"/>

                <Button x:Name="SyncUsersButton"
                        Content="{DynamicResource SyncUsers}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="130"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="SyncUsersButton_Click"/>

                <Button Content="{DynamicResource BackToLogin}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="150"
                        Height="40"
                        Margin="0 0 10 0"
                        Click="BackToLoginButton_Click"/>

                <Button Content="{DynamicResource UninstallProgram}"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="160"
                        Height="40"
                        Margin="0 0 10 0"
                        Click="UninstallButton_Click"/>

                <Button Content="{DynamicResource ExitProgram}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="130"
                        Height="40"
                        Click="ExitButton_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
