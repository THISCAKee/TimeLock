<Window x:Class="TimeLockApp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel"
        Width="1080"
        Height="680"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F9FAFB">

    <Grid Background="#F9FAFB"
          Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0 0 0 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="56"
                    Height="56"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="16"
                    Margin="0 0 14 0">
                <Image Source="/Assets/logo.png"
                       Width="42"
                       Height="42"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="Admin Panel"
                           Foreground="#111827"
                           FontSize="26"
                           FontWeight="SemiBold"/>

                <TextBlock Text="จัดการผู้ใช้งานและกำหนดเวลาการใช้งาน"
                           Foreground="#6B7280"
                           FontSize="14"
                           Margin="0 3 0 0"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- User Table Card -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="16">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.07"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Users"
                                       Foreground="#111827"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="เลือกผู้ใช้เพื่อแก้ไขข้อมูล"
                                       Foreground="#6B7280"
                                       FontSize="12"
                                       Margin="0 2 0 0"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="UsersDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="40"
                              Background="White"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionChanged="UsersDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="56"/>
                            <DataGridTextColumn Header="Username"
                                                Binding="{Binding Username}"
                                                Width="1.4*"/>
                            <DataGridTextColumn Header="Password"
                                                Binding="{Binding Password}"
                                                Width="1.2*"/>
                            <DataGridTextColumn Header="Minutes"
                                                Binding="{Binding AllowedMinutes}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Role"
                                                Binding="{Binding Role}"
                                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Form Card -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.07"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0 0 0 14">
                        <TextBlock Text="User Detail"
                                   Foreground="#111827"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="เพิ่มหรือแก้ไขข้อมูลผู้ใช้งาน"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0 2 0 0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <TextBlock Text="Username"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0 0 0 6"/>

                            <Border Height="42"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Margin="0 0 0 11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="👤"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBox x:Name="UsernameTextBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Password"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0 0 0 6"/>

                            <Border Height="42"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Margin="0 0 0 11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="🔒"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBox x:Name="PasswordTextBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Allowed Minutes"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0 0 0 6"/>

                            <Border Height="42"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Margin="0 0 0 11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="⏱"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBox x:Name="AllowedMinutesTextBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#111827"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             Padding="0"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Role"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0 0 0 6"/>

                            <ComboBox x:Name="RoleComboBox"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Margin="0 0 0 14">
                                <ComboBoxItem Content="user"/>
                                <ComboBoxItem Content="admin"/>
                            </ComboBox>

                            <TextBlock x:Name="MessageTextBlock"
                                       Foreground="#DC2626"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       MinHeight="34"
                                       Margin="0 2 0 8"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Buttons fixed bottom -->
                    <Grid Grid.Row="2"
                          Margin="0 14 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="เพิ่ม"
                                    Grid.Column="0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="40"
                                    Click="AddButton_Click"/>

                            <Button Content="แก้ไข"
                                    Grid.Column="2"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="40"
                                    Click="UpdateButton_Click"/>
                        </Grid>

                        <Button Content="ลบ User"
                                Grid.Row="2"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="40"
                                Click="DeleteButton_Click"/>

                        <Button Content="ล้างฟอร์ม"
                                Grid.Row="4"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="40"
                                Click="ClearButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2"
              Margin="0 20 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Tip: เลือก user จากตารางด้านซ้ายเพื่อแก้ไขข้อมูล"
                       Foreground="#6B7280"
                       FontSize="13"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="ประวัติการใช้งาน"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="160"
                        Height="40"
                        Margin="0 0 10 0"
                        Click="SessionHistoryButton_Click"/>

                <Button Content="ทดสอบ Google Sheet"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="170"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="TestGoogleSheetButton_Click"/>

                <Button Content="กลับหน้า Login"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="150"
                        Height="40"
                        Margin="0 0 10 0"
                        Click="BackToLoginButton_Click"/>

                <Button Content="ปิดโปรแกรม"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="130"
                        Height="40"
                        Click="ExitButton_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>