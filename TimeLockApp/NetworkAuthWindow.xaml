<Window x:Class="TimeLockApp.NetworkAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="เชื่อมต่ออินเทอร์เน็ต"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#F9FAFB"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="/Assets/logo.png"
                       Width="44"
                       Height="44"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0"/>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="เชื่อมต่ออินเทอร์เน็ต"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock x:Name="StatusTextBlock"
                               Text="กำลังเปิดหน้าระบบยืนยันตัวตน..."
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="ยกเลิก"
                        Width="100"
                        Height="38"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"/>
            </Grid>
        </Border>

        <!-- WebView -->
        <Border Grid.Row="1"
                Margin="20"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="16">

            <Grid>
                <wv2:WebView2 x:Name="AuthWebView"
                              Margin="1"/>

                <Grid x:Name="LoadingPanel"
                      Background="#F9FAFB">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <ProgressBar Width="220"
                                     Height="6"
                                     IsIndeterminate="True"/>

                        <TextBlock Text="กำลังโหลดหน้าระบบ Authen..."
                                   Foreground="#6B7280"
                                   FontSize="14"
                                   Margin="0,16,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="ErrorPanel"
                        Visibility="Collapsed"
                        Background="White">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="420">

                        <TextBlock Text="ไม่สามารถเปิดหน้าระบบ Authen ได้"
                                   Foreground="#111827"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>

                        <TextBlock x:Name="ErrorTextBlock"
                                   Text="กรุณาตรวจสอบการเชื่อมต่อเครือข่าย"
                                   Foreground="#6B7280"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,10,0,20"/>

                        <Button Content="ลองใหม่"
                                Width="130"
                                Height="42"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="RetryButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">
            <TextBlock Text="เมื่อยืนยันตัวตนสำเร็จ ระบบจะกลับไปหน้า Login อัตโนมัติ"
                       Foreground="#6B7280"
                       FontSize="13"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>